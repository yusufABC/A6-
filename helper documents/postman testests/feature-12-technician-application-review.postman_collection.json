{
  "info": {
    "name": "FSMS - Feature 12 - Technician Application Review (Admin)",
    "description": "Postman collection for Feature 12.\n\nEndpoints:\n- GET  /api/v1/technician-applications                (ADMIN)\n- POST /api/v1/technician-applications/:id/approve   (ADMIN)\n- POST /api/v1/technician-applications/:id/reject    (ADMIN)\n\nSetup:\n1. Import this collection.\n2. Open the collection Variables tab and set baseUrl, adminEmail/adminPassword, customerEmail/customerPassword.\n3. Start the server: npm run dev\n4. Run the folders in order: 0 Auth -> 1 Setup -> 2 List -> 3 Reject -> 4 Approve -> 5 Access Control -> 6 Validation.\n\nNotes:\n- The applicant must be a CUSTOMER. The seeded customer works.\n- For the multipart create request, select a JPEG/PNG/PDF file for the resume field.\n- After approval the old customer token becomes stale (401) because the role changed; the collection logs in again.\n- One PENDING application per user: the collection rejects the first application, then re-applies before approving.\n- To verify the single TechnicianProfile row and audit rows, use Prisma Studio or the SQL shown in the markdown guide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "customerPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "rejectApplicationId", "value": "" },
    { "key": "approveApplicationId", "value": "" },
    { "key": "applicantUserId", "value": "" },
    { "key": "longReviewNote", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth (run first)",
      "item": [
        {
          "name": "Login as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Login as CUSTOMER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer login succeeds', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.collectionVariables.set('customerToken', json.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "1. Setup - Create Application (CUSTOMER)",
      "item": [
        {
          "name": "Create PENDING application (saves rejectApplicationId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application submitted', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.status).to.eql('PENDING');",
                  "  pm.collectionVariables.set('rejectApplicationId', json.data.id);",
                  "  pm.collectionVariables.set('applicantUserId', json.data.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "resume", "type": "file", "src": [] },
                { "key": "additionalFiles", "type": "file", "src": [] },
                {
                  "key": "data",
                  "type": "text",
                  "value": "{\"professionalTitle\":\"Refrigeration Technician\",\"yearsOfExperience\":4,\"bio\":\"Experienced refrigeration technician.\",\"skills\":[\"Refrigeration\",\"AC Repair\"],\"serviceAreas\":[\"Dhaka\",\"Gazipur\"],\"workingDays\":{\"sun\":true,\"mon\":true,\"tue\":true,\"wed\":true,\"thu\":true,\"fri\":false,\"sat\":true},\"preferredHours\":\"09:00-18:00\"}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/technician-applications",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "GET /me (customer) - route order check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GET /me is matched as a route, not an id', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications/me",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin List",
      "item": [
        {
          "name": "List all (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin list succeeds with meta', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.meta).to.include.keys('page', 'limit', 'total', 'totalPages');",
                  "});",
                  "pm.test('Only non-deleted applications are listed', () => {",
                  "  const json = pm.response.json();",
                  "  json.data.forEach((app) => pm.expect(app.isDeleted).to.eql(false));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "List paginated + status + search + sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered list succeeds', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.meta.page).to.eql(1);",
                  "  pm.expect(json.meta.limit).to.eql(5);",
                  "  json.data.forEach((app) => pm.expect(app.status).to.eql('PENDING'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications?page=1&limit=5&status=PENDING&searchTerm=Refrigeration&sortBy=createdAt&sortOrder=desc",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Invalid status filter (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Invalid status rejected', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications?status=FOO",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Invalid sortBy (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Invalid sortBy rejected', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications?sortBy=password",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Limit over max (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('limit > 100 rejected', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technician-applications?page=1&limit=1000",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Reject Flow (ADMIN)",
      "item": [
        {
          "name": "Reject without reviewNote (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('reviewNote required', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{rejectApplicationId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Reject with blank reviewNote (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Blank reviewNote rejected', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"   \"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{rejectApplicationId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Reject with reviewNote (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application rejected', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.status).to.eql('REJECTED');",
                  "  pm.expect(json.data.reviewNote).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.reviewedAt).to.not.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Certificate is unreadable. Please re-apply with a clearer scan.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{rejectApplicationId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Reject twice (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Second reject is invalid transition', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Second attempt\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{rejectApplicationId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Reject non-existent id (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Unknown id returns 404', () => { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/00000000-0000-0000-0000-000000000000/reject",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Verify applicant still CUSTOMER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected applicant stays CUSTOMER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.role).to.eql('CUSTOMER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Approve Flow (ADMIN)",
      "item": [
        {
          "name": "Re-apply as CUSTOMER (saves approveApplicationId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Re-application submitted', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.status).to.eql('PENDING');",
                  "  pm.collectionVariables.set('approveApplicationId', json.data.id);",
                  "  pm.collectionVariables.set('applicantUserId', json.data.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "resume", "type": "file", "src": [] },
                { "key": "additionalFiles", "type": "file", "src": [] },
                {
                  "key": "data",
                  "type": "text",
                  "value": "{\"professionalTitle\":\"Refrigeration Technician\",\"yearsOfExperience\":4,\"bio\":\"Experienced refrigeration technician.\",\"skills\":[\"Refrigeration\",\"AC Repair\"],\"serviceAreas\":[\"Dhaka\",\"Gazipur\"],\"workingDays\":{\"sun\":true,\"mon\":true,\"tue\":true,\"wed\":true,\"thu\":true,\"fri\":false,\"sat\":true},\"preferredHours\":\"09:00-18:00\"}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/technician-applications",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Approve with reviewNote (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application approved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.application.status).to.eql('APPROVED');",
                  "  pm.expect(json.data.application.reviewedAt).to.not.eql(null);",
                  "  pm.expect(json.data.technicianProfile.userId).to.eql(pm.collectionVariables.get('applicantUserId'));",
                  "  pm.expect(json.data.technicianProfile.professionalTitle).to.eql('Refrigeration Technician');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Documents verified. Welcome aboard.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{approveApplicationId}}/approve",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Approve twice (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Second approve is invalid transition', () => { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Second attempt\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/technician-applications/{{approveApplicationId}}/approve",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        },
        {
          "name": "Old customer token is now stale (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Stale role token rejected', () => { pm.response.to.have.status(401); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
