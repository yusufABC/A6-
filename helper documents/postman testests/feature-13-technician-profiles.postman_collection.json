          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Soft-deleted profile is hidden', () => { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technicians/{{technicianProfileId}}",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Admin list after soft delete (id absent)",
          "event": [
