          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technicians?page=1&limit=100",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Access Control",
      "item": [
        {
          "name": "CUSTOMER calls /me/profile (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Customer is forbidden', () => { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/technicians/me/profile",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          }
