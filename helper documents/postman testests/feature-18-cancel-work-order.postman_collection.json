{
  "info": {
    "name": "FSMS - Feature 18 - Cancel Work Order and Work Order Read APIs",
    "description": "Postman collection for Feature 18.\n\nEndpoints:\n- GET /api/v1/work-orders (MANAGER, ADMIN - paginated, status filter)\n- GET /api/v1/work-orders/:id (MANAGER/ADMIN all, TECHNICIAN own assigned, CUSTOMER own)\n- POST /api/v1/work-orders/:id/cancel (MANAGER, ADMIN - body: reason required, cancels WO, request, assignment, appointment in one transaction, audits WORK_ORDER_CANCELLED, notifies customer and assigned technician).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "managerEmail", "value": "manager@example.com" },
    { "key": "managerPassword", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "technicianToken", "value": "" },
    { "key": "workOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth + Setup",
      "item": [
        {
          "name": "Login as MANAGER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager login succeeds', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.collectionVariables.set('managerToken', json.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "1. Work Order Read APIs",
      "item": [
        {
          "name": "GET /work-orders (Manager list)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List work orders succeeds', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  if (json.data.length > 0) {",
                  "    pm.collectionVariables.set('workOrderId', json.data[0].id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/work-orders"
          }
        },
        {
          "name": "GET /work-orders/:id (Detail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Work order detail retrieved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('workOrderId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/work-orders/{{workOrderId}}"
          }
        }
      ]
    },
    {
      "name": "2. Cancel Work Order",
      "item": [
        {
          "name": "POST /work-orders/:id/cancel (Missing reason -> 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing reason fails with 400', () => {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/work-orders/{{workOrderId}}/cancel"
          }
        },
        {
          "name": "POST /work-orders/:id/cancel (Manager - Cancel Work Order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Work order cancelled successfully', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation due to scheduling conflict\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/work-orders/{{workOrderId}}/cancel"
          }
        }
      ]
    }
  ]
}
