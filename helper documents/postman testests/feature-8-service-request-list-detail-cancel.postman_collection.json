            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests?status=PENDING_REVIEW",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"],
              "query": [
                { "key": "status", "value": "PENDING_REVIEW" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('all returned rows are PENDING_REVIEW', () => {",
                  "  json.data.forEach((item) => pm.expect(item.status).to.eql('PENDING_REVIEW'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List searchTerm=Split",
