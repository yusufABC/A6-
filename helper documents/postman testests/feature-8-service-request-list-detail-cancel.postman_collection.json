            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests?sortBy=createdAt&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"],
              "query": [
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "asc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('data is sorted ascending by createdAt', () => {",
                  "  const dates = json.data.map((item) => new Date(item.createdAt).getTime());",
                  "  for (let i = 1; i < dates.length; i += 1) {",
                  "    pm.expect(dates[i]).to.be.at.least(dates[i - 1]);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
