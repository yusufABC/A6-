    {
      "name": "List - GET /service-requests",
      "item": [
        {
          "name": "List own requests (customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(json.success).to.eql(true));",
                  "pm.test('data is an array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('meta has pagination fields', () => {",
                  "  pm.expect(json.meta).to.have.property('page');",
                  "  pm.expect(json.meta).to.have.property('limit');",
                  "  pm.expect(json.meta).to.have.property('total');",
                  "  pm.expect(json.meta).to.have.property('totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List with pagination (page=1&limit=2)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests?page=1&limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('limit is 2', () => pm.expect(json.meta.limit).to.eql(2));",
                  "pm.test('page is 1', () => pm.expect(json.meta.page).to.eql(1));",
                  "pm.test('data length <= 2', () => pm.expect(json.data.length).to.be.at.most(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "List filter by status=PENDING_REVIEW",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
