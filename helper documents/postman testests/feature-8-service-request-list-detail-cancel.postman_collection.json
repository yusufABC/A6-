              "path": ["api", "v1", "service-requests", "{{otherCustomerRequestId}}"]
            },
            "description": "Set otherCustomerRequestId to a request owned by a different customer first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "const json = pm.response.json();",
                  "pm.test('success is false', () => pm.expect(json.success).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel after assignment (expect 403)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{assignedRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests", "{{assignedRequestId}}"]
            },
            "description": "Set assignedRequestId to a request whose work order is ASSIGNED/SCHEDULED or later first. Feature 8 must reject it with 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "const json = pm.response.json();",
                  "pm.test('success is false', () => pm.expect(json.success).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel non-existent request (expect 404)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests", "00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const json = pm.response.json();",
                  "pm.test('success is false', () => pm.expect(json.success).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Verify",
      "item": [
        {
          "name": "Get cancelled request (customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests", "{{requestId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('request is CANCELLED', () => pm.expect(json.data.status).to.eql('CANCELLED'));",
                  "pm.test('workOrder is CANCELLED when present', () => {",
                  "  if (json.data.workOrder) pm.expect(json.data.workOrder.status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
