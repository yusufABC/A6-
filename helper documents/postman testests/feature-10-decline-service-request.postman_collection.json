            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "serviceId", "value": "{{serviceId}}", "type": "text" },
                { "key": "description", "value": "Feature 10 setup - manager decline happy path", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"]
            },
            "description": "Uses the existing Feature 7 create endpoint. Requires customerToken to be a CUSTOMER with a complete address. Stores managerDeclineRequestId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(json.success).to.eql(true));",
                  "pm.test('starts as PENDING_REVIEW', () => pm.expect(json.data.status).to.eql('PENDING_REVIEW'));",
                  "if (json && json.data && json.data.id) {",
