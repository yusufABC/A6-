            { "key": "resume", "type": "file", "src": [] },
            { "key": "data", "type": "text", "value": "{\"professionalTitle\":\"Refrigeration Technician\",\"yearsOfExperience\":4,\"skills\":[],\"serviceAreas\":[\"Dhaka\"]}" }
          ]
        },
        "url": "{{baseUrl}}/api/v1/technician-applications"
      }
    },
    {
      "name": "13 - Invalid File Type (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
